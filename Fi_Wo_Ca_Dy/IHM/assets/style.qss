/* ============================================================
   GE IHM SDR — Feuille de style Qt Dark Mode
   Palette : fond #0d1117, accents cyan #00d4ff, violet #7b61ff
   ============================================================ */

/* ── Global ───────────────────────────────────────────────── */
QMainWindow, QDialog, QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #161b22;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #484f58; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }

/* ── Config Panel ─────────────────────────────────────────── */
#ConfigPanel {
    background-color: #161b22;
    border-right: 1px solid #21262d;
}

#ConfigContent {
    background-color: transparent;
}

#PanelTitle {
    background-color: #1c2128;
    color: #00d4ff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 14px 10px;
    border-bottom: 1px solid #21262d;
}

#ActionBar {
    background-color: #1c2128;
    border-top: 1px solid #21262d;
}

/* ── GroupBox ─────────────────────────────────────────────── */
QGroupBox#ConfigGroup {
    background-color: #0d1117;
    border: 1px solid #21262d;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
    color: #8b949e;
    font-size: 11px;
    letter-spacing: 0.3px;
}
QGroupBox#ConfigGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: -1px;
    padding: 0 6px;
    background-color: #161b22;
    color: #58a6ff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

/* ── Labels ───────────────────────────────────────────────── */
QLabel {
    color: #8b949e;
    font-size: 11px;
}

#InfoLabel {
    color: #6e7681;
    font-size: 10px;
    background-color: #161b22;
    border-radius: 4px;
    padding: 6px 8px;
}

/* ── Inputs ───────────────────────────────────────────────── */
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
    selection-background-color: #1f6feb;
}
QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #58a6ff;
}
QLineEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover, QComboBox:hover {
    border: 1px solid #484f58;
}

QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #21262d;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    border: 1px solid #30363d;
    border-radius: 4px;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #30363d;
    border: none;
    width: 18px;
    border-radius: 3px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #484f58;
}

/* ── CheckBox ─────────────────────────────────────────────── */
QCheckBox {
    color: #8b949e;
    font-size: 12px;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #484f58;
    border-radius: 4px;
    background-color: #21262d;
}
QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border-color: #58a6ff;
}
QCheckBox::indicator:hover { border-color: #58a6ff; }

/* ── Buttons ──────────────────────────────────────────────── */
QPushButton {
    font-size: 12px;
    font-weight: 600;
    border-radius: 7px;
    padding: 8px 12px;
    border: none;
    letter-spacing: 0.3px;
}

#BtnPrimary {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #0d419d, stop:1 #1158c7
    );
    color: #ffffff;
}
#BtnPrimary:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1158c7, stop:1 #2f81f7
    );
}
#BtnPrimary:disabled { background: #21262d; color: #484f58; }

#BtnSecondary {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4a3094, stop:1 #7b61ff
    );
    color: #ffffff;
}
#BtnSecondary:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7b61ff, stop:1 #9d85ff
    );
}
#BtnSecondary:disabled { background: #21262d; color: #484f58; }

#BtnDanger {
    background: #6e1010;
    color: #ffa8a8;
}
#BtnDanger:hover { background: #a01f1f; }
#BtnDanger:disabled { background: #21262d; color: #484f58; }

#BtnExport {
    background: #1a2f1a;
    color: #56d364;
    border: 1px solid #238636;
}
#BtnExport:hover {
    background: #238636;
    color: #ffffff;
}

/* ── Tab Widget ───────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #21262d;
    background: #0d1117;
    border-radius: 0px 8px 8px 8px;
}
QTabBar::tab {
    background: #161b22;
    color: #8b949e;
    border: 1px solid #21262d;
    border-bottom: none;
    padding: 8px 20px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 6px 6px 0 0;
    min-width: 100px;
}
QTabBar::tab:selected {
    background: #0d1117;
    color: #00d4ff;
    border-bottom: 2px solid #00d4ff;
}
QTabBar::tab:hover:!selected {
    background: #21262d;
    color: #e6edf3;
}

/* ── Progress Bar ─────────────────────────────────────────── */
QProgressBar {
    background-color: #21262d;
    border: none;
    border-radius: 5px;
    text-align: center;
    color: #e6edf3;
    font-size: 11px;
    height: 14px;
}
QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00d4ff, stop:1 #7b61ff
    );
    border-radius: 5px;
}

/* ── Status Bar ───────────────────────────────────────────── */
QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    border-top: 1px solid #21262d;
    font-size: 11px;
}
QStatusBar QLabel {
    color: #8b949e;
    font-size: 11px;
    padding: 0 8px;
}

/* ── Text Edit (Log) ──────────────────────────────────────── */
QTextEdit {
    background-color: #0d1117;
    color: #8b949e;
    border: 1px solid #21262d;
    border-radius: 6px;
    font-family: "Consolas", "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    padding: 6px;
    selection-background-color: #1f6feb;
}

/* ── Splitter ─────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #21262d;
    width: 2px;
    height: 2px;
}
QSplitter::handle:hover {
    background-color: #58a6ff;
}

/* ── Tool Tips ────────────────────────────────────────────── */
QToolTip {
    background-color: #1c2128;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}
